#drone_navigate.srv A saudade é o azar de quem ja teve muita sorte um dia 
float32 x
float32 y
float32 z
float32 yaw  # Target yaw in radians (optional, use NaN to maintain current yaw)
float32 yaw_rate  # Yaw rate in rad/s (0 or NaN = no rotation, >0 = rotate at this rate)
float32 speed
string frame_id
bool auto_arm
---
bool success
string message