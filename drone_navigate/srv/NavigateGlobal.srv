# NavigateGlobal.srv - GPS-based navigation service
# Request: Navigate using GPS coordinates (lat/lon)
float64 lat
float64 lon
float32 z
float32 yaw
float32 yaw_rate  # Yaw rate in rad/s (0 or NaN = no rotation, >0 = rotate at this rate)
float32 speed
string frame_id
bool auto_arm
---
# Response
bool success
string message
