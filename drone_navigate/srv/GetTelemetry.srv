# GetTelemetry.srv - Compatible with Clover's get_telemetry service
# Request: The frame_id you want the coordinates in (e.g., 'map', 'body', 'navigate_target')
string frame_id
---
# Response: Position, Orientation (Euler), and Velocity
string frame_id
bool connected
bool armed
string mode
float64 x
float64 y
float64 z
float64 lat
float64 lon
float64 alt
float64 vx
float64 vy
float64 vz
float64 pitch
float64 roll
float64 yaw
float32 roll_rate
float32 pitch_rate
float32 yaw_rate
float32 voltage
float32 cell_voltage