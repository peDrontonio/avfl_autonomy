<?xml version='1.0'?>
<sdf version="1.9">
  <model name="nelore">
    <include merge="true">
      <uri>model://iris_with_standoffs</uri>
      <name>iris</name>
    </include>

    <!-- ============================================================ -->
    <!-- Intel RealSense D455i — Front-facing stereo + depth + IMU    -->
    <!-- Specs: 124x29x26 mm, 72g, 95mm stereo baseline, BMI055 IMU  -->
    <!-- ============================================================ -->

    <!-- D455 body link (main physical body, front-facing) -->
    <!-- Pose: 0.1m forward from base_link center -->
    <link name="d455_link">
      <pose>0.1 0 0 0 0 0</pose>
      <inertial>
        <mass>0.072</mass>
        <inertia>
          <ixx>0.0000588</ixx>  <!-- 1/12*m*(h^2+d^2) -->
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0000120</iyy>  <!-- 1/12*m*(w^2+d^2) -->
          <iyz>0</iyz>
          <izz>0.0000618</izz>  <!-- 1/12*m*(w^2+h^2) -->
        </inertia>
      </inertial>
      <visual name="d455_visual">
        <pose>0.013 0.0475 0.0145 0 0 0</pose> <!-- center the STL mesh -->
        <geometry>
          <mesh>
            <uri>meshes/d455.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
        </material>
      </visual>
      <collision name="d455_collision">
        <geometry>
          <box>
            <size>0.026 0.124 0.029</size>
          </box>
        </geometry>
      </collision>
    </link>
    <joint name="d455_joint" type="fixed">
      <parent>base_link</parent>
      <child>d455_link</child>
    </joint>

    <!-- D455 Left IR camera (infra1) — reference stereo sensor -->
    <!-- Located at the depth module origin (left side of the body) -->
    <link name="d455_infra1_frame">
      <pose relative_to="d455_link">0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000001</iyy><iyz>0</iyz><izz>0.000001</izz>
        </inertia>
      </inertial>
    </link>
    <joint name="d455_infra1_joint" type="fixed">
      <parent>d455_link</parent>
      <child>d455_infra1_frame</child>
    </joint>

    <!-- Left IR optical frame (ROS convention: Z-forward, X-right, Y-down) -->
    <link name="d455_infra1_optical_frame">
      <pose relative_to="d455_infra1_frame">0 0 0 -1.5708 0 -1.5708</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000001</iyy><iyz>0</iyz><izz>0.000001</izz>
        </inertia>
      </inertial>
      <sensor name="d455_infra1" type="camera">
        <gz_frame_id>d455_infra1_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.518</horizontal_fov>  <!-- 87 degrees -->
          <image>
            <width>640</width>
            <height>480</height>
            <format>L8</format>  <!-- Grayscale (IR) -->
          </image>
          <clip>
            <near>0.1</near>
            <far>20</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.005</stddev>
          </noise>
          <lens>
            <intrinsics>
              <fx>383.19</fx>
              <fy>383.19</fy>
              <cx>320.0</cx>
              <cy>240.0</cy>
              <s>0</s>
            </intrinsics>
          </lens>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <topic>/d455/infra1/image_rect_raw</topic>
      </sensor>
    </link>
    <joint name="d455_infra1_optical_joint" type="fixed">
      <parent>d455_infra1_frame</parent>
      <child>d455_infra1_optical_frame</child>
    </joint>

    <!-- D455 Right IR camera (infra2) — 95mm baseline from left IR -->
    <link name="d455_infra2_frame">
      <pose relative_to="d455_link">0 -0.095 0 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000001</iyy><iyz>0</iyz><izz>0.000001</izz>
        </inertia>
      </inertial>
    </link>
    <joint name="d455_infra2_joint" type="fixed">
      <parent>d455_link</parent>
      <child>d455_infra2_frame</child>
    </joint>

    <!-- Right IR optical frame -->
    <link name="d455_infra2_optical_frame">
      <pose relative_to="d455_infra2_frame">0 0 0 -1.5708 0 -1.5708</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000001</iyy><iyz>0</iyz><izz>0.000001</izz>
        </inertia>
      </inertial>
      <sensor name="d455_infra2" type="camera">
        <gz_frame_id>d455_infra2_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.518</horizontal_fov>  <!-- 87 degrees -->
          <image>
            <width>640</width>
            <height>480</height>
            <format>L8</format>  <!-- Grayscale (IR) -->
          </image>
          <clip>
            <near>0.1</near>
            <far>20</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.005</stddev>
          </noise>
          <lens>
            <intrinsics>
              <fx>383.19</fx>
              <fy>383.19</fy>
              <cx>320.0</cx>
              <cy>240.0</cy>
              <s>0</s>
            </intrinsics>
          </lens>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <topic>/d455/infra2/image_rect_raw</topic>
      </sensor>
    </link>
    <joint name="d455_infra2_optical_joint" type="fixed">
      <parent>d455_infra2_frame</parent>
      <child>d455_infra2_optical_frame</child>
    </joint>

    <!-- D455 Depth camera (aligned to left IR / depth module origin) -->
    <link name="d455_depth_frame">
      <pose relative_to="d455_link">0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000001</iyy><iyz>0</iyz><izz>0.000001</izz>
        </inertia>
      </inertial>
    </link>
    <joint name="d455_depth_joint" type="fixed">
      <parent>d455_link</parent>
      <child>d455_depth_frame</child>
    </joint>

    <link name="d455_depth_optical_frame">
      <pose relative_to="d455_depth_frame">0 0 0 -1.5708 0 -1.5708</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000001</iyy><iyz>0</iyz><izz>0.000001</izz>
        </inertia>
      </inertial>
      <sensor name="d455_depth" type="depth_camera">
        <gz_frame_id>d455_depth_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.518</horizontal_fov>  <!-- 87 degrees -->
          <image>
            <width>640</width>
            <height>480</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.4</near>
            <far>14</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.01</stddev>
          </noise>
          <lens>
            <intrinsics>
              <fx>383.19</fx>
              <fy>383.19</fy>
              <cx>320.0</cx>
              <cy>240.0</cy>
              <s>0</s>
            </intrinsics>
          </lens>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <topic>/d455/depth/image_rect_raw</topic>
      </sensor>
    </link>
    <joint name="d455_depth_optical_joint" type="fixed">
      <parent>d455_depth_frame</parent>
      <child>d455_depth_optical_frame</child>
    </joint>

    <!-- D455 Color camera (RGB) — offset 59mm right from depth module -->
    <link name="d455_color_frame">
      <pose relative_to="d455_link">0 -0.059 0 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000001</iyy><iyz>0</iyz><izz>0.000001</izz>
        </inertia>
      </inertial>
    </link>
    <joint name="d455_color_joint" type="fixed">
      <parent>d455_link</parent>
      <child>d455_color_frame</child>
    </joint>

    <link name="d455_color_optical_frame">
      <pose relative_to="d455_color_frame">0 0 0 -1.5708 0 -1.5708</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000001</iyy><iyz>0</iyz><izz>0.000001</izz>
        </inertia>
      </inertial>
      <sensor name="d455_color" type="camera">
        <gz_frame_id>d455_color_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.5708</horizontal_fov>  <!-- 90 degrees -->
          <image>
            <width>640</width>
            <height>480</height>
            <format>RGB_INT8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.005</stddev>
          </noise>
          <lens>
            <intrinsics>
              <fx>383.19</fx>
              <fy>383.19</fy>
              <cx>320.0</cx>
              <cy>240.0</cy>
              <s>0</s>
            </intrinsics>
          </lens>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>/d455/color/image_raw</topic>
      </sensor>
    </link>
    <joint name="d455_color_optical_joint" type="fixed">
      <parent>d455_color_frame</parent>
      <child>d455_color_optical_frame</child>
    </joint>

    <!-- D455 IMU (BMI055 6-axis, same position as real D455) -->
    <link name="d455_imu_frame">
      <pose relative_to="d455_link">-0.01602 -0.03022 0.0074 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000001</iyy><iyz>0</iyz><izz>0.000001</izz>
        </inertia>
      </inertial>
    </link>
    <joint name="d455_imu_joint" type="fixed">
      <parent>d455_link</parent>
      <child>d455_imu_frame</child>
    </joint>

    <link name="d455_imu_optical_frame">
      <pose relative_to="d455_imu_frame">0 0 0 -1.5708 0 -1.5708</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000001</iyy><iyz>0</iyz><izz>0.000001</izz>
        </inertia>
      </inertial>
      <sensor name="d455_imu" type="imu">
        <gz_frame_id>d455_imu_optical_frame</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>200</update_rate>
        <topic>/d455/imu</topic>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.1</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.1</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.1</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>
    <joint name="d455_imu_optical_joint" type="fixed">
      <parent>d455_imu_frame</parent>
      <child>d455_imu_optical_frame</child>
    </joint>

    <!-- Bottom Camera (downward-facing for mission 2) -->
    <link name="bottom_camera_link">
      <!-- Position: center of drone (x=0, y=0), slightly below body (z=-0.08) -->
      <!-- Rotation: 90 degrees around Y-axis to point downward (pitch = 1.5708 rad) -->
      <pose>0 0 -0.08 0 1.5708 0</pose>
      <inertial>
        <mass>0.015</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00001</iyy>
          <iyz>0</iyz>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <visual name="bottom_camera_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.02 0.03 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1</ambient>
          <diffuse>0.2 0.2 0.2</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>
      <sensor name="bottom_camera" type="camera">
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>/bottom_camera</topic>
      </sensor>
    </link>
    <joint name="bottom_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>bottom_camera_link</child>
    </joint>

    <!-- <include merge="true">
      <uri>package://ardupilot_gazebo/models/gimbal_small_3d</uri>
      <name>gimbal</name>
      <pose degrees="true">0 -0.01 -0.124923 90 0 90</pose>
    </include>

    <joint name="gimbal_joint" type="revolute">
      <parent>base_link</parent>
      <child>gimbal_link</child>
      <axis>
        <limit>
          <lower>0</lower>
