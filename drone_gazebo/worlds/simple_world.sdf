<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="map">
    
    <!-- Physics configuration -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    
    <!-- ============================================================
         PLUGINS  (sensor plugins necessários para o drone Nelore)
    ============================================================ -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-air-pressure-system"
      name="gz::sim::systems::AirPressure">
    </plugin>
    <plugin filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <plugin filename="gz-sim-magnetometer-system"
      name="gz::sim::systems::Magnetometer">
    </plugin>
    <plugin filename="gz-sim-navsat-system"
      name="gz::sim::systems::NavSat">
    </plugin>

    <!-- ============================================================
         ILUMINAÇÃO
    ============================================================ -->

    <!-- Sol: luz direcional com ângulo de meio-dia (~60° acima do horizonte) -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 500 0 0 0</pose>
      <direction>0.3 0.1 -1.0</direction>
      <diffuse>0.95 0.92 0.85 1</diffuse>
      <specular>0.4 0.4 0.35 1</specular>
    </light>

    <!-- Luz ambiente suave para preencher sombras -->
    <light type="directional" name="ambient_fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <direction>-0.2 -0.1 -1.0</direction>
      <diffuse>0.35 0.40 0.48 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
    </light>

    <!-- Luz extra na área dos ArUco markers -->
    <light type="point" name="arch_light">
      <cast_shadows>false</cast_shadows>
      <pose>0 2 3 0 0 0</pose>
      <diffuse>0.6 0.6 0.6 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.5</constant>
        <linear>0.02</linear>
        <quadratic>0.002</quadratic>
      </attenuation>
    </light>

    <!-- Luz extra para markers inferiores -->
    <light type="point" name="lower_marker_light">
      <cast_shadows>false</cast_shadows>
      <pose>0 2 1.5 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>8</range>
        <constant>0.4</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- Luzes internas do hangar (pose do hangar: 0 -60 12) -->
    <light type="point" name="hangar_light_1">
      <cast_shadows>false</cast_shadows>
      <pose>8 -60 18 0 0 0</pose>
      <diffuse>1.0 0.95 0.85 1</diffuse>
      <specular>0.5 0.5 0.4 1</specular>
      <attenuation>
        <range>40</range>
        <constant>0.3</constant>
        <linear>0.02</linear>
        <quadratic>0.005</quadratic>
      </attenuation>
    </light>

    <light type="point" name="hangar_light_2">
      <cast_shadows>false</cast_shadows>
      <pose>-8 -60 18 0 0 0</pose>
      <diffuse>1.0 0.95 0.85 1</diffuse>
      <specular>0.5 0.5 0.4 1</specular>
      <attenuation>
        <range>40</range>
        <constant>0.3</constant>
        <linear>0.02</linear>
        <quadratic>0.005</quadratic>
      </attenuation>
    </light>

    <light type="point" name="hangar_light_center">
      <cast_shadows>false</cast_shadows>
      <pose>0 -60 20 0 0 0</pose>
      <diffuse>1.0 0.98 0.92 1</diffuse>
      <specular>0.6 0.6 0.5 1</specular>
      <attenuation>
        <range>50</range>
        <constant>0.2</constant>
        <linear>0.015</linear>
        <quadratic>0.003</quadratic>
      </attenuation>
    </light>

    <!-- ============================================================
         GPS / COORDENADAS ESFÉRICAS
    ============================================================ -->
    <spherical_coordinates>
      <latitude_deg>-35.3632621</latitude_deg>
      <longitude_deg>149.1652374</longitude_deg>
      <elevation>10.0</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <!-- ============================================================
         TERRENO  (grama texturizada substituindo o plano cinza)
    ============================================================ -->
    <include>
      <uri>model://grass_ground</uri>
      <name>ground_plane</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- ============================================================
         PAREDES DO CAMPO
    ============================================================ -->

    <!-- Parede 1 - Frente -->
    <model name="wall_front">
      <static>true</static>
      <pose>10 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 30 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 30 2</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Parede 2 - Trás -->
    <model name="wall_back">
      <static>true</static>
      <pose>-10 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 30 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 30 2</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Parede 3 - Esquerda -->
    <model name="wall_left">
      <static>true</static>
      <pose>0 10 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>30 0.2 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>30 0.2 2</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Parede 4 - Direita -->
    <model name="wall_right">
      <static>true</static>
      <pose>0 -10 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>30 0.2 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>30 0.2 2</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================
         QUADRADO FLUTUANTE  (estrutura dos ArUco markers)
    ============================================================ -->

    <!-- Quadrado flutuante - Lado 1 (Frente) -->
    <model name="floating_square_front">
      <static>true</static>
      <pose>2.75 2.75 2 0 0 1.5707963267948966</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 0.1 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 0.1 1.5</size></box></geometry>
          <material>
            <ambient>0.8 0.4 0.2 1</ambient>
            <diffuse>0.8 0.4 0.2 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Quadrado flutuante - Lado 2 (Trás) -->
    <model name="floating_square_back">
      <static>true</static>
      <pose>2.75 1.25 2 0 0 1.5707963267948966</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 0.1 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 0.1 1.5</size></box></geometry>
          <material>
            <ambient>0.8 0.4 0.2 1</ambient>
            <diffuse>0.8 0.4 0.2 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Quadrado flutuante - Lado 3 (Esquerda) -->
    <model name="floating_square_left">
      <static>true</static>
      <pose>2.75 2 2.75 0 1.57 1.5707963267948966</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 0.1 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 0.1 1.5</size></box></geometry>
          <material>
            <ambient>0.8 0.4 0.2 1</ambient>
            <diffuse>0.8 0.4 0.2 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Quadrado flutuante - Lado 4 (Direita) -->
    <model name="floating_square_right">
      <static>true</static>
      <pose>2.75 2 1.25 0 1.57 1.5707963267948966</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 0.1 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 0.1 1.5</size></box></geometry>
          <material>
