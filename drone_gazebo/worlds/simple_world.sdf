            <diffuse>0.8 0.4 0.2 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================
         ARUCO MARKERS
    ============================================================ -->

    <!-- Marcador ArUco 0 - Front Bottom Corner -->
    <include>
      <uri>model://aruco_marker_0</uri>
      <name>aruco_marker_0</name>
      <pose>2.65 2.75 1.25 0 1.57079 3.14159</pose>
