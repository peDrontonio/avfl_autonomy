<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="color_h_base">
    <static>true</static>

    <link name="base_link">
      <!-- Main base plate: same dimensions as h_base (1.5m x 1.5m) -->
      <collision name="base_collision">
        <geometry>
          <box>
            <size>1.5 1.5 0.01</size>
          </box>
        </geometry>
      </collision>

      <visual name="base_visual">
        <pose>0 0 0.005 0 0 0</pose>
        <geometry>
          <box>
            <size>1.5 1.5 0.01</size>
          </box>
        </geometry>
        <material>
          <ambient>1.0 1.0 1.0 1</ambient>
          <diffuse>1.0 1.0 1.0 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <emissive>0.05 0.05 0.05 1</emissive>
          <pbr>
            <metal>
              <albedo_map>model://color_h_base/materials/textures/base_h_color.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
