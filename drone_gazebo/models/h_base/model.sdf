<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="h_base">
    <static>true</static>
    
    <link name="base_link">
      <!-- Main helipad surface with texture -->
      <collision name="base_collision">
        <geometry>
          <box>
            <size>1.5 1.5 0.01</size>
          </box>
        </geometry>
      </collision>
      <visual name="base_visual">
        <pose>0 0 0.005 0 0 0</pose>
        <geometry>
          <box>
            <size>1.5 1.5 0.01</size>
          </box>
        </geometry>
        <material>
          <ambient>1.0 1.0 1.0 1</ambient>
          <diffuse>1.0 1.0 1.0 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr>
            <metal>
              <albedo_map>baseH.jpeg</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
